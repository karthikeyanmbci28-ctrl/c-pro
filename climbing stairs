class Solution {
public:
    int fibonaci(int m){
        vector<int>r(m+1);
        for(int i=0;i<=m;i++){
            if(i==0|i==1|i==2){
                r[i]=i;
            }
            else {
                r[i]=r[i-1]+r[i-2];
            }
        }
        return r[m];
        
    }

    int climbStairs(int n) {
        int result=fibonaci(n);
        return result;
    }
};
