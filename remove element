#include <vector>

class Solution {
public:
    int removeElement(std::vector<int>& nums, int val) {
        int k = 0; // Pointer to track the position of valid elements

        // Iterate through the array with a fast pointer
        for (int i = 0; i < nums.size(); ++i) {
            // If current element is NOT the value to remove
            if (nums[i] != val) {
                nums[k] = nums[i]; // Move valid element to the front
                k++;               // Advance the valid position tracker
            }
        }

        return k; // k is the count of elements not equal to val
    }
};
