char* reverseOnlyLetters(char* s) 
{
    int start = 0;
    int end = strlen(s)-1;
    while(start < end)
    {
        if(isalpha(s[start]) && isalpha(s[end]))
        {
            char temp=s[start];
            s[start]=s[end];
            s[end]=temp;
            start++;
            end--;
        }
        else if(!isalpha(s[start]))
        {
            start++;
        }
        else if(!isalpha(s[end]))
        {
         end--;
        }  
    }
    return s;
}
