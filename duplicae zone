void duplicateZeros(int* arr, int arrSize) {
    for (int i = 0; i < arrSize; i++)
    {
        if (arr[i] == 0 && i != arrSize - 1)
        {
            for(int k = arrSize - 2; k > i; k--)
            {
                arr[k + 1] = arr[k];
            }
            arr[i + 1] = 0;
            i ++;
        }
    }
}
