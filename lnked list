/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     ListNode *next;
 *     ListNode(x) : val(x), next(nullptr) {}
 * };
 */

class Solution {
public:
    bool hasCycle(ListNode *head) {
        // Base case: An empty list or a list with only one node cannot have a cycle
        if (head == nullptr || head->next == nullptr) {
            return false;
        }
        
        ListNode *slow = head;
        ListNode *fast = head;
        
        // Traverse the list as long as the fast pointer can move forward two steps
        while (fast != nullptr && fast->next != nullptr) {
            slow = slow->next;          // Moves 1 step
            fast = fast->next->next;    // Moves 2 steps
            
            // If they meet, a cycle exists
            if (slow == fast) {
                return true;
            }
        }
        
        // Fast pointer reached the end of the list, so there is no cycle
        return false;
    }
};
