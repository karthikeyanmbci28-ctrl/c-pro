#include <iostream>
#include <vector>
#include <string>

class Solution {
public:
    std::string longestCommonPrefix(std::vector<std::string>& strs) {
        // Handle empty array boundary case
        if (strs.empty()) return "";
        
        // Loop character by character through the first string
        for (int i = 0; i < strs[0].length(); ++i) {
            char currentChar = strs[0][i];
            
            // Compare this character with the same position in all other strings
            for (int j = 1; j < strs.size(); ++j) {
                // If out of bounds or characters don't match, return prefix found so far
                if (i == strs[j].length() || strs[j][i] != currentChar) {
                    return strs[0].substr(0, i);
                }
            }
        }
        
        return strs[0]; // The entire first string is the common prefix
    }
};

