#include <vector>
#include <unordered_set>

class Solution {
public:
    bool containsNearbyDuplicate(std::vector<int>& nums, int k) {
        std::unordered_set<int> window;
        
        for (int i = 0; i < nums.size(); ++i) {
            // Step 2: If the element is already in our window, a valid duplicate exists
            if (window.find(nums[i]) != window.end()) {
                return true;
            }
            
            // Insert current element into the sliding window set
            window.insert(nums[i]);
            
            // Step 3: Clean up the oldest element if the window exceeds size k
            if (i >= k) {
                window.erase(nums[i - k]);
            }
        }
        
        return false;
    }
};
