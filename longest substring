#include <string>
#include <vector>
#include <algorithm>

class Solution {
public:
    int longestSubstring(std::string s, int k) {
        int n = s.length();
        // Base case: If string is empty or shorter than k, no valid substring is possible
        if (n == 0 || k > n) return 0;
        // Optimization: If k is 1, the entire string itself is valid
        if (k <= 1) return n;

        // Step 1: Count frequency of each character in the current substring
        std::vector<int> counts(26, 0);
        for (char c : s) {
            counts[c - 'a']++;
        }

        // Step 2: Look for a split point (a character with count > 0 but < k)
        for (int i = 0; i < n; ++i) {
            if (counts[s[i] - 'a'] > 0 && counts[s[i] - 'a'] < k) {
                // Step 3 & 4: Divide the string and find the max from left and right halves
                int leftLength = longestSubstring(s.substr(0, i), k);
                int rightLength = longestSubstring(s.substr(i + 1), k);
                
                return std::max(leftLength, rightLength);
            }
        }

        // Step 5: If no split points were found, the entire current string is valid
        return n;
    }
};
